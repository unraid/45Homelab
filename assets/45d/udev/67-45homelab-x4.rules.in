# X4: map onboard SATA ports to physical bays.
# The installer replaces __X4_SATA_BDF__ with the detected controller address.
# This file runs before the generic 68-vdev rule so serial links cannot claim
# an X4 bay after a drive moves.

SUBSYSTEM!="block", GOTO="45homelab_x4_end"
ACTION!="add|change", GOTO="45homelab_x4_end"
DEVPATH!="*/__X4_SATA_BDF__/ata*", GOTO="45homelab_x4_end"

ENV{DEVTYPE}=="disk", ENV{DISK_HANDLED_BY_CUSTOM_ALIASES}="1"

ENV{DEVTYPE}=="disk",      DEVPATH=="*/__X4_SATA_BDF__/ata8/*", SYMLINK+="disk/by-vdev/1-1"
ENV{DEVTYPE}=="disk",      DEVPATH=="*/__X4_SATA_BDF__/ata7/*", SYMLINK+="disk/by-vdev/1-2"
ENV{DEVTYPE}=="disk",      DEVPATH=="*/__X4_SATA_BDF__/ata6/*", SYMLINK+="disk/by-vdev/1-3"
ENV{DEVTYPE}=="disk",      DEVPATH=="*/__X4_SATA_BDF__/ata5/*", SYMLINK+="disk/by-vdev/1-4"
ENV{DEVTYPE}=="partition", DEVPATH=="*/__X4_SATA_BDF__/ata8/*", SYMLINK+="disk/by-vdev/1-1-part%n"
ENV{DEVTYPE}=="partition", DEVPATH=="*/__X4_SATA_BDF__/ata7/*", SYMLINK+="disk/by-vdev/1-2-part%n"
ENV{DEVTYPE}=="partition", DEVPATH=="*/__X4_SATA_BDF__/ata6/*", SYMLINK+="disk/by-vdev/1-3-part%n"
ENV{DEVTYPE}=="partition", DEVPATH=="*/__X4_SATA_BDF__/ata5/*", SYMLINK+="disk/by-vdev/1-4-part%n"

LABEL="45homelab_x4_end"
